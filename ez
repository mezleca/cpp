#!/usr/bin/env python3

import os
import sys
import shutil
import subprocess
import platform
import argparse

from pathlib import Path

CWD = Path.cwd()

BUILD_DIR = CWD / "build"
SOURCE_DIR = CWD
BINARY_NAME = "app"
QT_PLUGINS_DIR_NAME = "plugins"
QT_QML_DIR_NAME = "qml"
QT_DLL_PREFIX = "Qt6"
ICU_DLL_PREFIXES = ["icudt", "icuin", "icuuc"]
MINGW_RUNTIME_DLLS = ["libgcc_s_seh-1.dll", "libstdc++-6.dll", "libwinpthread-1.dll"]
MINGW_LINUX_SYSROOT = "/usr/x86_64-w64-mingw32"
QT_VERSION          = "6.6.2"

SYSTEM = platform.system()

def run(cmd: str, check: bool = True, env: dict | None = None, capture: bool = False) -> tuple[int, str]:
    print(f"exec: {cmd}")
    result = subprocess.run(
        cmd,
        shell=True,
        env=env,
        capture_output=capture,
        text=capture,
        cwd=str(CWD) if SYSTEM == "Windows" else None,
    )

    if check and result.returncode != 0:
        print(f"command failed with exit code {result.returncode}")
        sys.exit(result.returncode)

    return result.returncode, result.stdout or ""

def tool_exists(tool: str) -> None:
    if shutil.which(tool) is None:
        raise Exception(f"{tool} not found in PATH")

def cmake_list(items: list[str]) -> str:
    return "\\;".join(items)

def get_cpu_count() -> int:
    if SYSTEM == "Linux":
        result = subprocess.run("nproc", shell=True, capture_output=True, text=True)
        cores = result.stdout.strip()
        return int(cores) if cores.isdigit() else os.cpu_count() or 4
    return os.cpu_count() or 4

def get_qt_mingw_prefix() -> str:
    return os.environ.get("QT_MINGW_PREFIX", "").strip() or str(Path.home() / "qt" / QT_VERSION / "mingw_64")

def read_cached_build_type() -> str | None:
    cache = BUILD_DIR / "CMakeCache.txt"
    if not cache.exists():
        return None
    
    for line in cache.read_text(errors="replace").splitlines():
        if line.startswith("CMAKE_BUILD_TYPE:STRING="):
            return line.split("=", 1)[1].strip().lower()
        
    return None

def init() -> int:
    print("initializing submodules...")

    if Path(".gitmodules").exists() and run("git submodule update --init --recursive", check=False)[0] != 0:
        print("failed to initialize submodules")
        return 1
    
    tool_exists("cmake")
    tool_exists("ninja")

    if SYSTEM == "Windows":
        tool_exists("gcc")
        tool_exists("g++")
        tool_exists("windres")   
    else:
        tool_exists("clang")

    return 0

def format_code() -> int:
    return run("clang-format -i $(rg --files -g '*.{h,hpp,cpp,cc,cxx}' src)")[0]

def clean() -> int:
    if not BUILD_DIR.exists():
        print("build directory doesn't exist")
        return 0
    
    print("removing build directory...")

    try:
        shutil.rmtree(BUILD_DIR)
        return 0
    except PermissionError:
        print("permission denied")
        return 1

def configure_linux(build_type: str) -> int:
    cache = BUILD_DIR / "CMakeCache.txt"

    if cache.exists():
        cache.unlink()

    BUILD_DIR.mkdir(exist_ok=True)
    cmake_type = "Debug" if build_type == "debug" else "Release"
    cmd = [
        "cmake -Wno-dev -G Ninja",
        f"-B {BUILD_DIR}",
        f"-S {SOURCE_DIR}",
        f"-DCMAKE_BUILD_TYPE={cmake_type}",
        "-DCMAKE_C_COMPILER=clang",
        "-DCMAKE_CXX_COMPILER=clang++",
        f"-DOUTPUT_NAME={BINARY_NAME}",
    ]
    return run(" ".join(cmd))[0]

def configure_windows(build_type: str) -> int:
    cache = BUILD_DIR / "CMakeCache.txt"

    if cache.exists():
        cache.unlink()

    BUILD_DIR.mkdir(exist_ok=True)

    is_windows_host = os.name == "nt"
    qt_mingw_prefix = get_qt_mingw_prefix()
    qt_host_path    = os.environ.get("QT_HOST_PATH", "").strip() or str(Path.home() / "qt" / QT_VERSION / "gcc_64")
    qt_host_cmake   = os.environ.get("QT_HOST_PATH_CMAKE_DIR", "").strip() or str(Path(qt_host_path) / "lib" / "cmake")
    qt_config       = Path(qt_mingw_prefix) / "lib" / "cmake" / "Qt6" / "Qt6Config.cmake"

    if not qt_config.exists():
        print(f"qt mingw not found: {qt_config}")
        return 1

    cmake_type = "Debug" if build_type == "debug" else "Release"
    toolchain  = SOURCE_DIR / "cmake" / "mingw-cross.cmake" if not is_windows_host else None

    find_root = cmake_list([qt_mingw_prefix, MINGW_LINUX_SYSROOT]) if not is_windows_host else ""

    cmd = [
        "cmake -Wno-dev -G Ninja",
        f"-B {BUILD_DIR}",
        f"-S {SOURCE_DIR}",
        f"-DCMAKE_BUILD_TYPE={cmake_type}",
        *([f"-DCMAKE_TOOLCHAIN_FILE={toolchain}"] if toolchain else []),
        f"-DOUTPUT_NAME={BINARY_NAME}",
        "-DREALM_USE_SYSTEM_OPENSSL=ON",
        f"-DCMAKE_PREFIX_PATH={qt_mingw_prefix}",
        f"-DQt6_DIR={qt_config.parent}",
        f"-DQT_HOST_PATH={qt_host_path}",
        f"-DQT_HOST_PATH_CMAKE_DIR={qt_host_cmake}",
        *([f"-DCMAKE_FIND_ROOT_PATH={find_root}"] if find_root else []),
    ]
    
    return run(" ".join(cmd))[0]

def configure(build_type: str, target_platform: str) -> int:
    is_windows = target_platform == "windows" or (target_platform == "auto" and SYSTEM == "Windows")
    is_linux   = target_platform == "linux"   or (target_platform == "auto" and SYSTEM == "Linux")

    if is_windows:
        return configure_windows(build_type)
    
    if is_linux:
        return configure_linux(build_type)
    
    print(f"unsupported platform: {SYSTEM}")
    return 1

def build(build_type: str | None) -> int:
    cached = read_cached_build_type()

    if cached is None:
        if configure(build_type or "release", "auto") != 0:
            return 1
    elif build_type is not None and build_type != cached:
        if configure(build_type, "auto") != 0:
            return 1

    return run(f"ninja -C {BUILD_DIR} -j{get_cpu_count()}")[0]

def copy_dlls(src_dir: Path, dst_dir: Path, names: list[str]) -> None:
    for name in names:
        src = src_dir / name
        if src.exists():
            shutil.copy2(src, dst_dir / name)

def copy_matching_dlls(src_dir: Path, dst_dir: Path, prefix: str) -> None:
    if not src_dir.exists():
        return
    
    for entry in src_dir.iterdir():
        if entry.is_file() and entry.suffix.lower() == ".dll" and entry.name.startswith(prefix):
            shutil.copy2(entry, dst_dir / entry.name)

def stage_windows_runtime(binary_dir: Path) -> None:
    qt_mingw_prefix = get_qt_mingw_prefix()
    qt_bin     = Path(qt_mingw_prefix) / "bin"
    qt_plugins = Path(qt_mingw_prefix) / QT_PLUGINS_DIR_NAME
    qt_qml     = Path(qt_mingw_prefix) / QT_QML_DIR_NAME
    mingw_bin  = Path("/usr/x86_64-w64-mingw32/bin")

    binary_dir.mkdir(parents=True, exist_ok=True)

    copy_dlls(mingw_bin, binary_dir, MINGW_RUNTIME_DLLS)
    copy_matching_dlls(qt_bin, binary_dir, QT_DLL_PREFIX)

    for prefix in ICU_DLL_PREFIXES:
        copy_matching_dlls(qt_bin, binary_dir, prefix)

    if qt_plugins.exists():
        shutil.copytree(qt_plugins, binary_dir / QT_PLUGINS_DIR_NAME, dirs_exist_ok=True)
    if qt_qml.exists():
        shutil.copytree(qt_qml, binary_dir / QT_QML_DIR_NAME, dirs_exist_ok=True)

def run_binary() -> int:
    candidates: list[Path] = []

    if SYSTEM == "Linux":
        candidates = [BUILD_DIR / BINARY_NAME, BUILD_DIR / f"{BINARY_NAME}.exe"]
    elif SYSTEM == "Windows":
        candidates = [
            BUILD_DIR / f"{BINARY_NAME}.exe",
            BUILD_DIR / "Release" / f"{BINARY_NAME}.exe",
            BUILD_DIR / "Debug"   / f"{BINARY_NAME}.exe",
        ]
    else:
        print(f"unsupported platform: {SYSTEM}")
        return 1

    binary = next((p for p in candidates if p.exists()), None)

    if binary is None:
        print("binary not found")
        return 1

    return run(str(binary))[0]

def main() -> None:
    parser = argparse.ArgumentParser(description="build script for c++ projects")

    parser.add_argument("command", choices=["init", "configure", "format", "build", "clean", "run", "test"])
    parser.add_argument("--type", choices=["debug", "release"], default=None, dest="build_type")
    parser.add_argument("--platform", choices=["auto", "linux", "windows"], default="auto")
    parser.add_argument("--run", action="store_true")

    args = parser.parse_args()

    commands = {
        "init":      init,
        "configure": lambda: configure(args.build_type or "release", args.platform),
        "build":     lambda: build(args.build_type),
        "format":    format_code,
        "clean":     clean,
        "run":       run_binary,
        "test":      run_binary,
    }

    exit_code = commands[args.command]()

    if args.command == "build" and exit_code == 0 and args.run:
        exit_code = run_binary()

    sys.exit(exit_code)

if __name__ == "__main__":
    main()
